# --- SQLite (POC default) -------------------------------------------------
DB_DRIVER=sqlite
DB_DATABASE=startfest.sqlite
DB_LOGGING=false
PORT=3000

# --- MSSQL (switch the driver, no schema rewrite) -------------------------
# Entity column types are already portable. Note that `synchronize` is off for
# MSSQL by design -- generate and run TypeORM migrations instead.
# DB_DRIVER=mssql
# DB_HOST=localhost
# DB_PORT=1433
# DB_USERNAME=sa
# DB_PASSWORD=
# DB_NAME=startfest
# DB_ENCRYPT=true
# DB_TRUST_CERT=true
